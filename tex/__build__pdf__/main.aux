\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.1}Material particulado fino (PM$_{2.5}$)}{39}{subsection.5.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces PM$_{2.5}$ por condado (año base) y prevalencia de asma (\textit  {All ages}). Los condados se ordenan de mayor a menor nivel del contaminante. La ausencia de un patrón creciente claro sugiere que, en este corte temporal, la asociación lineal condal es débil o está enmascarada por otros factores.}}{39}{figure.5.1}\protected@file@percent }
\newlabel{fig:pm25_allages}{{5.1}{39}{PM$_{2.5}$ por condado (año base) y prevalencia de asma (\textit {All ages}). Los condados se ordenan de mayor a menor nivel del contaminante. La ausencia de un patrón creciente claro sugiere que, en este corte temporal, la asociación lineal condal es débil o está enmascarada por otros factores}{figure.5.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.2}Material particulado grueso (PM$_{10}$)}{39}{subsection.5.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces PM$_{10}$ por condado (año base) y prevalencia de asma (\textit  {All ages}). Al igual que con PM$_{2.5}$, no se observa un gradiente claro de prevalencia al aumentar el contaminante. La presencia de valores extremos sugiere sensibilidad a outliers y refuerza la necesidad de análisis robustos y multivariantes.}}{40}{figure.5.2}\protected@file@percent }
\newlabel{fig:pm10_allages}{{5.2}{40}{PM$_{10}$ por condado (año base) y prevalencia de asma (\textit {All ages}). Al igual que con PM$_{2.5}$, no se observa un gradiente claro de prevalencia al aumentar el contaminante. La presencia de valores extremos sugiere sensibilidad a outliers y refuerza la necesidad de análisis robustos y multivariantes}{figure.5.2}{}}
